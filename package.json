{
  "name": "yuyin-music-mobile",
  "version": "0.1.1",
  "private": true,
  "description": "余音 Android 手机版，独立于 PC 版管理",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "android:sync": "npm run build && cap sync android",
    "android:build": "node scripts/build-android.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/android": "8.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/node": "24.0.0",
    "@vitejs/plugin-react": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.0.0",
    "tsx": "4.20.0",
    "playwright": "1.58.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panda472328/yuyin-music-mobile.git"
  },
