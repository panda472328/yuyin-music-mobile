<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/yuyin_green</item>
        <item name="colorPrimaryDark">@color/yuyin_splash</item>
        <item name="colorAccent">@color/yuyin_green</item>
        <item name="android:windowBackground">@color/yuyin_splash</item>
        <item name="android:statusBarColor">@color/yuyin_splash</item>
        <item name="android:navigationBarColor">@color/yuyin_splash</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/yuyin_splash</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/yuyin_splash</item>
        <item name="windowSplashScreenBackground">@color/yuyin_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_yuyin</item>
        <item name="android:statusBarColor">@color/yuyin_splash</item>
        <item name="android:navigationBarColor">@color/yuyin_splash</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
